<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/backgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post Coconut Video"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:layout_marginBottom="4dp"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"/>

        <VideoView
            android:id="@+id/video_preview"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="8dp"
            android:background="#000000"/>

        <Button
            android:id="@+id/btn_select_video"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Select Video"
            android:textAllCaps="false"
            android:backgroundTint="@color/colorPrimary"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-medium"
            android:padding="0dp"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/et_post_name"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Name"
            android:padding="8dp"
            android:background="@drawable/rounded_edittext"
            android:layout_marginBottom="8dp"
            android:maxLength="30"
            android:textSize="14sp"
            android:textColor="@color/textColorPrimary"
            android:textColorHint="@color/textColorSecondary"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <EditText
                android:id="@+id/et_post_mobile"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Mobile"
                android:inputType="phone"
                android:padding="8dp"
                android:background="@drawable/rounded_edittext"
                android:layout_marginEnd="8dp"
                android:maxLength="10"
                android:textSize="14sp"
                android:textColor="@color/textColorPrimary"
                android:textColorHint="@color/textColorSecondary"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"/>

            <EditText
                android:id="@+id/et_post_area"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Area"
                android:padding="8dp"
                android:background="@drawable/rounded_edittext"
                android:maxLength="30"
                android:textSize="14sp"
                android:textColor="@color/textColorPrimary"
                android:textColorHint="@color/textColorSecondary"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"/>
        </LinearLayout>

        <EditText
            android:id="@+id/et_post_cost"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Cost"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:background="@drawable/rounded_edittext"
            android:layout_marginTop="8dp"
            android:maxLength="10"
            android:textSize="14sp"
            android:textColor="@color/textColorPrimary"
            android:textColorHint="@color/textColorSecondary"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btn_upload_video"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Post to Feed"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="@color/colorSuccess"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:padding="0dp"
            android:fontFamily="sans-serif-medium"/>

        <ProgressBar
            android:id="@+id/upload_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:progressTint="@color/colorPrimary"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:textColor="@color/colorPrimary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>
</ScrollView>
